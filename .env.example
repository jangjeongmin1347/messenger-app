# 이 파일을 .env로 복사한 뒤 실제 값으로 채워넣으세요.
# 로컬 개발: cp .env.example .env

# ---- 데이터베이스 ----
# Supabase, Neon, Render Postgres 등 매니지드 PostgreSQL 연결 문자열
DATABASE_URL="postgresql://user:password@localhost:5432/messenger"

# ---- 인증 토큰 ----
# 아무 랜덤 문자열이나 사용 (예: openssl rand -base64 32)
# 주의: Next.js 앱과 realtime-server 두 곳에 반드시 "같은 값"을 넣어야 합니다.
JWT_SECRET=

# ---- 전화번호 인증 (Twilio Verify) ----
# 비워두면 콘솔에 인증번호(123456 고정)를 출력하는 개발용 목 모드로 동작합니다.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- 음성/영상 통화 (Agora) ----
# https://console.agora.io 에서 프로젝트 생성 후 발급
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- 실시간 서버 연결 ----
# Next.js 앱이 어느 주소의 realtime-server에 접속할지 (브라우저에 노출되는 값)
# 로컬 개발: http://localhost:4000
# 배포 후: 실시간 서버를 올린 실제 URL (예: https://messenger-realtime.onrender.com)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# ---- 실시간 서버 포트 / CORS ----
REALTIME_PORT=4000
# 배포된 프론트엔드 도메인으로 제한 (쉼표로 여러 개 가능). 비워두면 전체 허용(개발용).
CORS_ORIGIN=
